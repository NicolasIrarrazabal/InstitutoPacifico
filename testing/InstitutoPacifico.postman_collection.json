          "name": "POST Registrar asistencia (PRESENTE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "// La respuesta tiene estructura anidada: { asistencia: { id }, resumenR2: {...} }",
                  "var id = jsonData.asistencia ? jsonData.asistencia.id : jsonData.id;",
                  "if (id) {",
                  "  pm.environment.set('asistenciaId', id);",
                  "  console.log('asistenciaId:', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}:{{asistencia}}/api/v1/asistencias",
            "body": {
              "mode": "raw",
