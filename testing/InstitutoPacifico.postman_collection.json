{
  "info": {
    "name": "Instituto Pacifico - Todos los Microservicios",
    "description": "Colección completa de endpoints para los 10 microservicios del proyecto Instituto Pacifico.\n\n**Instrucciones:**\n1. Asegúrate de tener todos los microservicios iniciados (puertos 8080-8089)\n2. Usa Collection Runner para ejecutar todo en orden\n3. Los scripts generan IDs automáticos y los capturan de las respuestas\n4. Todo el ciclo CREATE → READ → UPDATE → DELETE funciona sin intervención",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost", "type": "default" },
    { "key": "aranceles", "value": "8081", "type": "default" },
    { "key": "asignaturas", "value": "8080", "type": "default" },
    { "key": "asistencia", "value": "8088", "type": "default" },
    { "key": "carreras", "value": "8084", "type": "default" },
    { "key": "docente", "value": "8082", "type": "default" },
    { "key": "empresas", "value": "8089", "type": "default" },
    { "key": "estudiante", "value": "8085", "type": "default" },
    { "key": "matriculas", "value": "8083", "type": "default" },
    { "key": "notas", "value": "8086", "type": "default" },
    { "key": "practicas", "value": "8087", "type": "default" },
    { "key": "estudianteRut", "value": "", "type": "default" },
    { "key": "empresaRut", "value": "", "type": "default" },
    { "key": "uniqueRunTag", "value": "", "type": "default" },
    { "key": "carreraId", "value": "", "type": "default" },
    { "key": "asignatura1Id", "value": "", "type": "default" },
    { "key": "asignatura2Id", "value": "", "type": "default" },
    { "key": "especialidadId", "value": "", "type": "default" },
    { "key": "docenteId", "value": "", "type": "default" },
    { "key": "empresaId", "value": "", "type": "default" },
    { "key": "estudianteId", "value": "", "type": "default" },
    { "key": "matriculaId", "value": "", "type": "default" },
    { "key": "arancelId", "value": "", "type": "default" },
    { "key": "notaId", "value": "", "type": "default" },
    { "key": "asistenciaId", "value": "", "type": "default" },
    { "key": "practicaId", "value": "", "type": "default" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "javascript",
        "exec": [
          "// Generar valores únicos una sola vez al inicio",
          "var now = new Date();",
          "var tag = ('000' + now.getHours()).slice(-2) + ('000' + now.getMinutes()).slice(-2) + ('000' + now.getSeconds()).slice(-2) + ('000' + now.getMilliseconds()).slice(-3);",
          "if (!pm.environment.get('uniqueRunTag')) {",
          "  pm.environment.set('uniqueRunTag', tag);",
          "  var rutNum = '1' + tag.slice(0,7);",
          "  pm.environment.set('uniqueRut', rutNum + '-9');",
          "}",
          "",
          "// Limpiar IDs al inicio de una nueva ejecución (Collection Runner)",
          "if (!pm.environment.get('executionStarted')) {",
          "  pm.environment.set('executionStarted', 'true');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "FASE 1: Carreras",
      "item": [
        {
          "name": "POST Crear carrera",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "  pm.environment.set('carreraId', jsonData.id);",
                  "  console.log('carreraId:', jsonData.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}:{{carreras}}/api/v1/carreras",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ingenieria en Sistemas {{uniqueRunTag}}\",\n  \"descripcion\": \"Carrera de ingenieria\",\n  \"duracionSemestres\": 8,\n  \"sede\": \"Santiago\"\n}"
            }
          }
        },
        {
          "name": "GET Listar carreras",
          "request": { "method": "GET", "url": "{{baseUrl}}:{{carreras}}/api/v1/carreras" }
        },
        {
          "name": "GET Get carrera",
          "request": { "method": "GET", "url": "{{baseUrl}}:{{carreras}}/api/v1/carreras/{{carreraId}}" }
        },
        {
          "name": "PUT Actualizar carrera",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}:{{carreras}}/api/v1/carreras/{{carreraId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ingenieria Actualizada {{uniqueRunTag}}\",\n  \"descripcion\": \"Carrera actualizada\",\n  \"duracionSemestres\": 10,\n  \"sede\": \"Santiago\"\n}"
            }
          }
        },
        {
          "name": "DELETE Eliminar carrera",
          "request": { "method": "DELETE", "url": "{{baseUrl}}:{{carreras}}/api/v1/carreras/{{carreraId}}" }
        }
      ]
    },
