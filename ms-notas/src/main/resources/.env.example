# ─────────────────────────────────────────────────────────────
# Archivo .env — Variables de entorno para ms-notas
# INSTRUCCIONES:
#   1. Copia este archivo y renómbralo a: .env
#   2. Reemplaza los valores con los de tu base de datos real
#   3. Agrega .env al .gitignore (¡NUNCA subas este archivo a GitHub!)
# ─────────────────────────────────────────────────────────────

# Conexión a la base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ms_notas_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# URL del microservicio ms-matriculas (para validar la Regla R1)
# Asegúrate de que ms-matriculas esté corriendo en ese puerto
MS_MATRICULAS_URL=http://localhost:8083
