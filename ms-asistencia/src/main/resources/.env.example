# ─────────────────────────────────────────────────────────────
# Archivo .env — Variables de entorno para ms-asistencia
# INSTRUCCIONES:
#   1. Copia este archivo y renómbralo a: .env
#   2. Rellena con tus datos reales
#   3. Agrega .env al .gitignore (¡NUNCA subas esto a GitHub!)
# ─────────────────────────────────────────────────────────────

# Conexión a la base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ms_asistencia_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# URL del microservicio ms-matriculas
# Se usa para validar que el estudiante esté matriculado antes de registrar asistencia
MS_MATRICULAS_URL=http://localhost:8083
